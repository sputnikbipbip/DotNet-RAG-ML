<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
        <PackageReference Include="Azure.Search.Documents" Version="12.1.0-beta.2" />
        <PackageReference Include="itext7" Version="9.7.0" />
        <PackageReference Include="itext7.bouncy-castle-adapter" Version="9.7.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
        <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.10.0" />
        <PackageReference Include="Microsoft.SemanticKernel" Version="1.80.1" />
        <PackageReference Include="Microsoft.SemanticKernel.Connectors.AzureAISearch" Version="1.74.0-preview" />
        <PackageReference Include="Microsoft.SemanticKernel.Connectors.AzureOpenAI" Version="1.80.1" />
        <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.80.1" />
        <PackageReference Include="OpenAI" Version="2.14.0" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\css\" />
    </ItemGroup>

</Project>
